<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="CollegeListReport"
              pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- Fields -->
    <field name="id" class="java.lang.Long"/>
    <field name="collegeName" class="java.lang.String"/>
    <field name="city" class="java.lang.String"/>
    <field name="university" class="java.lang.String"/>
    <field name="contactNo" class="java.lang.String"/>

    <!-- ================= Title ================= -->
    <title>
        <band height="55">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="46"
                               backcolor="#1565C0" forecolor="#1565C0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="4" width="555" height="38"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[College List Report]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= Page Header ================= -->
    <pageHeader>
        <band height="18">

            <staticText>
                <reportElement x="0" y="0" width="277" height="18"
                               forecolor="#666666"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Online Result System]]></text>
            </staticText>

            <textField pattern="dd-MM-yyyy HH:mm">
                <reportElement x="277" y="0" width="278" height="18"
                               forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- ================= Column Header ================= -->
    <columnHeader>
        <band height="26">

            <rectangle>
                <reportElement x="0" y="0" width="555" height="26"
                               backcolor="#0D2137"
                               forecolor="#0D2137"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Sequence -->
            <staticText>
                <reportElement x="0" y="0" width="30" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>

            <!-- ID -->
            <staticText>
                <reportElement x="30" y="0" width="45" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <!-- College Name -->
            <staticText>
                <reportElement x="75" y="0" width="170" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[College Name]]></text>
            </staticText>

            <!-- City -->
            <staticText>
                <reportElement x="245" y="0" width="90" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[City]]></text>
            </staticText>

            <!-- University -->
            <staticText>
                <reportElement x="335" y="0" width="140" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[University]]></text>
            </staticText>

            <!-- Contact No -->
            <staticText>
                <reportElement x="475" y="0" width="80" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Contact No]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ================= Detail ================= -->
    <detail>
        <band height="22">

            <rectangle>
                <reportElement x="0" y="0" width="555" height="22"
                               backcolor="#EEF2F7">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Sequence -->
            <textField>
                <reportElement x="0" y="0" width="30" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <!-- ID -->
            <textField>
                <reportElement x="30" y="0" width="45" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <!-- College Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="75" y="0" width="170" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{collegeName}]]></textFieldExpression>
            </textField>

            <!-- City -->
            <textField isBlankWhenNull="true">
                <reportElement x="245" y="0" width="90" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{city}]]></textFieldExpression>
            </textField>

            <!-- University -->
            <textField isBlankWhenNull="true">
                <reportElement x="335" y="0" width="140" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{university}]]></textFieldExpression>
            </textField>

            <!-- Contact No -->
            <textField isBlankWhenNull="true">
                <reportElement x="475" y="0" width="80" height="22"
                               forecolor="#555555"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{contactNo}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ================= Page Footer ================= -->
    <pageFooter>
        <band height="20">

            <line>
                <reportElement x="0" y="0" width="555" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <staticText>
                <reportElement x="0" y="3" width="277" height="16"
                               forecolor="#888888"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Online Result System - College List Report]]></text>
            </staticText>

            <textField>
                <reportElement x="277" y="3" width="278" height="16"
                               forecolor="#888888"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- ================= Summary ================= -->
    <summary>
        <band height="30">

            <line>
                <reportElement x="0" y="4" width="555" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <textField>
                <reportElement x="0" y="10" width="300" height="18"
                               forecolor="#1565C0"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Colleges: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
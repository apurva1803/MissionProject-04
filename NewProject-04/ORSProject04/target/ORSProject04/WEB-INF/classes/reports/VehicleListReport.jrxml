<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="VehicleListReport"
              pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- Fields -->
    <field name="id" class="java.lang.Long"/>
    <field name="vehicleNo" class="java.lang.String"/>
    <field name="ownerName" class="java.lang.String"/>
    <field name="model" class="java.lang.String"/>
    <field name="color" class="java.lang.String"/>

    <!-- ================= Title ================= -->
    <title>
        <band height="55">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="46"
                               backcolor="#1565C0"
                               forecolor="#1565C0"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="4" width="555" height="38"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Vehicle List Report]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= Page Header ================= -->
    <pageHeader>
        <band height="18">

            <staticText>
                <reportElement x="0" y="0" width="277" height="18"
                               forecolor="#666666"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Online Result System]]></text>
            </staticText>

            <textField pattern="dd-MM-yyyy HH:mm">
                <reportElement x="277" y="0" width="278" height="18"
                               forecolor="#666666"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- ================= Column Header ================= -->
    <columnHeader>
        <band height="26">

            <rectangle>
                <reportElement x="0" y="0" width="555" height="26"
                               backcolor="#0D2137"
                               forecolor="#0D2137"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Sequence -->
            <staticText>
                <reportElement x="0" y="0" width="30" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>

            <!-- ID -->
            <staticText>
                <reportElement x="30" y="0" width="50" height="26"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <!-- Vehicle No -->
            <staticText>
                <reportElement x="80" y="0" width="140" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Vehicle No]]></text>
            </staticText>

            <!-- Owner Name -->
            <staticText>
                <reportElement x="220" y="0" width="140" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Owner Name]]></text>
            </staticText>

            <!-- Model -->
            <staticText>
                <reportElement x="360" y="0" width="110" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Model]]></text>
            </staticText>

            <!-- Color -->
            <staticText>
                <reportElement x="470" y="0" width="85" height="26"
                               forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Color]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ================= Detail ================= -->
    <detail>
        <band height="22">

            <rectangle>
                <reportElement x="0" y="0" width="555" height="22"
                               backcolor="#EEF2F7">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>

            <!-- Sequence -->
            <textField>
                <reportElement x="0" y="0" width="30" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <!-- ID -->
            <textField>
                <reportElement x="30" y="0" width="50" height="22"
                               forecolor="#888888"/>
                <textElement textAlignment="Center"
                             verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <!-- Vehicle No -->
            <textField isBlankWhenNull="true">
                <reportElement x="80" y="0" width="140" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vehicleNo}]]></textFieldExpression>
            </textField>

            <!-- Owner Name -->
            <textField isBlankWhenNull="true">
                <reportElement x="220" y="0" width="140" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ownerName}]]></textFieldExpression>
            </textField>

            <!-- Model -->
            <textField isBlankWhenNull="true">
                <reportElement x="360" y="0" width="110" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{model}]]></textFieldExpression>
            </textField>

            <!-- Color -->
            <textField isBlankWhenNull="true">
                <reportElement x="470" y="0" width="85" height="22"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{color}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ================= Page Footer ================= -->
    <pageFooter>
        <band height="20">

            <line>
                <reportElement x="0" y="0" width="555" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <staticText>
                <reportElement x="0" y="3" width="277" height="16"
                               forecolor="#888888"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Online Result System - Vehicle List Report]]></text>
            </staticText>

            <textField>
                <reportElement x="277" y="3" width="278" height="16"
                               forecolor="#888888"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- ================= Summary ================= -->
    <summary>
        <band height="30">

            <line>
                <reportElement x="0" y="4" width="555" height="1"
                               forecolor="#CCCCCC"/>
            </line>

            <textField>
                <reportElement x="0" y="10" width="300" height="18"
                               forecolor="#1565C0"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total Vehicles: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>